# ==============================================================================
# AETHERBUILDER ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE & AI CONFIGURATION
# ------------------------------------------------------------------------------
# Gemini API Key: Required for Aether AI Assistant generation & auto-prompts.
GEMINI_API_KEY=""

# Application URL (e.g., https://your-project.vercel.app or http://localhost:3000)
APP_URL=""

# ------------------------------------------------------------------------------
# 2. PERSISTENT DATABASE STORAGE (Choose Upstash Redis / Vercel KV OR Supabase)
# ------------------------------------------------------------------------------
# OPTION A: Vercel KV / Upstash Redis (Recommended for Vercel serverless deployments)
# When deploying to Vercel, attach "Vercel KV" from Storage tab to auto-inject these:
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# Or using Upstash directly:
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# OPTION B: Supabase (PostgreSQL with PostgREST)
SUPABASE_URL=""
SUPABASE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ------------------------------------------------------------------------------
# 3. CLOUDINARY MEDIA HOSTING (Images, SVGs & Transparent Mascot WebM Videos)
# ------------------------------------------------------------------------------
# Bypasses Vercel 4.5MB serverless limits, delivers media through global edge CDN,
# and provides permanent storage for mascot videos & high-res image assets.
# (Sign up free at https://cloudinary.com - 25GB free monthly bandwidth/storage)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_PRESET=""
CLOUDINARY_FOLDER="aether-assets"

# ------------------------------------------------------------------------------
# 4. ADMIN & PORTAL SECURITY
# ------------------------------------------------------------------------------
ADMIN_PASSWORD=""
PORTAL_SECRET_KEY=""
