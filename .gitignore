# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Large Archive Files & Duplicate Deployment Folders
*.zip
!aetherbuilder-update.zip
dist_package/
update_stage/
elementor-builder*/

# User Uploads & Backups (Preserve directory structure without committing heavy user media)
data/backups/*
!data/backups/.gitkeep
assets/uploads/*
!assets/uploads/.gitkeep

# Sensitive runtime data (never expose these on GitHub)
data/revisions/*
!data/revisions/.gitkeep
data/config.json
data/ratelimit.json
data/submissions.json
data/site.json

# Logs & Temp files
*.log
temp_*
