# ============================================================
#  AETHERBUILDER — Apache .htaccess
#  Optimized for InfinityFree, AwardSpace & standard cPanel
# ============================================================

# ── HTTPS Redirect ─────────────────────────────────────────────
# Force all traffic to HTTPS (InfinityFree provides free SSL)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# ── Directory Index ────────────────────────────────────────────
DirectoryIndex index.php index.html

# ── Correct MIME Types ─────────────────────────────────────────
# Ensures ES Modules, CSS, fonts and icons load properly
<IfModule mod_mime.c>
    AddType application/javascript          .js .mjs
    AddType text/css                        .css
    AddType application/json                .json
    AddType image/svg+xml                   .svg
    AddType font/woff                       .woff
    AddType font/woff2                      .woff2
    AddType font/ttf                        .ttf
    AddType image/x-icon                   .ico
    AddType image/png                       .png
    AddType image/webp                      .webp
    AddType video/mp4                       .mp4
    AddType video/webm                      .webm
</IfModule>

# ── Cache & Security Headers ───────────────────────────────────
<IfModule mod_headers.c>
    # HTML and PHP dynamic entrypoints
    <FilesMatch "\.(html|htm|php)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
    # Prevent stale builder JavaScript and site data caching
    <FilesMatch "\.(js|mjs|json)$">
        Header set Cache-Control "no-cache, must-revalidate"
        Header set Pragma "no-cache"
    </FilesMatch>
    # Static assets, fonts, icons, media
    <FilesMatch "\.(css|woff|woff2|ttf|png|jpg|jpeg|gif|webp|svg|ico|mp4|webm)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

# ── Protect Private Submissions ────────────────────────────────
<FilesMatch "^(submissions\.json|.*\.log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Block direct access to sensitive data files
    RewriteRule ^data/(submissions\.json|revisions/|config\.json|ratelimit\.json) - [F,L]
</IfModule>

# ── Gzip Compression ──────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json text/plain
</IfModule>
